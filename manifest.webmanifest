{
  "name": "Munch — meals, inventory & shopping",
  "short_name": "Munch",
  "description": "Plan breakfast, lunch and dinner against what you actually have in — at home and at work — and let the shopping list follow the plan.",
  "id": "munch-meal-planner",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#FBF7F2",
  "theme_color": "#FBF7F2",
  "lang": "en-GB",
  "dir": "ltr",
  "categories": ["food", "lifestyle", "productivity"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/favicon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Shopping list", "short_name": "Shop", "url": "./#shop", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "This week's plan", "short_name": "Plan", "url": "./#plan", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "What's in stock", "short_name": "Stock", "url": "./#inventory", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
